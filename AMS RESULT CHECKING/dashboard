<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ST. PAUL'S SCHOOLS | Parent Dashboard</title>

<link rel="icon" href="{{ url_for('static', filename='images/favicon.ico') }}" type="image/x-icon">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<link rel="stylesheet" href="{{ url_for('static', filename='dashboard.css') }}">

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

<div class="container-fluid">

<a class="navbar-brand fw-bold">

<img src="{{ url_for('static', filename='images/logo.png') }}" width="45">

ST. PAUL'S SCHOOLS

</a>

<button class="btn btn-danger" onclick="logout()">

<i class="bi bi-box-arrow-right"></i>

Logout

</button>

</div>

</nav>

<!-- HEADER -->

<div class="container mt-4">

<div class="card shadow-lg">

<div class="card-body">

<div class="row">

<div class="col-md-2 text-center">

<img src="{{ url_for('static', filename='images/logo.png') }}" width="45">

</div>

<div class="col-md-10">

<h2 class="text-primary">

ACADEMIC REPORT PORTAL

</h2>

<p>

New Kutunku, Gwagwalada, Abuja

</p>

</div>

</div>

</div>

</div>

</div>

<!-- STUDENT DETAILS -->

<div class="container mt-4">

<div class="card shadow">

<div class="card-header bg-success text-white">

<h4>

Student Information

</h4>

</div>

<div class="card-body">

<div class="row">

<div class="col-md-4">

<b>Student Name</b>

<p id="studentName"></p>

</div>

<div class="col-md-4">

<b>Admission Number</b>

<p id="admission"></p>

</div>

<div class="col-md-4">

<b>Class</b>

<p id="className"></p>

</div>

</div>

</div>

</div>

</div>

<!-- FILTERS -->

<div class="container mt-4">

<div class="card shadow">

<div class="card-header bg-dark text-white">

<h4>

View Academic Result

</h4>

</div>

<div class="card-body">

<div class="row">

    <!-- Academic Session -->

    <div class="col-md-5">

        <label class="form-label">

            Academic Session

        </label>

        <input
            type="text"
            id="year"
            class="form-control"
            placeholder="Example: 2026">

    </div>

    <!-- Term -->

    <div class="col-md-5">

        <label class="form-label">

            Term

        </label>

        <select
            id="term"
            class="form-select">

            <option value="">

                -- Select Term --

            </option>

            <option value="First Term">

                First Term

            </option>

            <option value="Second Term">

                Second Term

            </option>

            <option value="Third Term">

                Third Term

            </option>

        </select>

    </div>

    <!-- View Button -->

    <div class="col-md-2">

        <label>&nbsp;</label>

        <button
            class="btn btn-primary w-100"
            onclick="viewResult()">

            View

        </button>

    </div>

</div>

</div>

</div>

</div>

<!-- RESULT -->

<div class="container mt-4">

<div class="card shadow">

<div class="card-header bg-info text-white">

<h4>

Result Sheet

</h4>

</div>

<div class="card-body">

<div id="result">

<h5 class="text-center">

Select Session and Term

</h5>

</div>

</div>

</div>

</div>

<!-- DOWNLOAD -->

<div class="container mt-4 mb-5">

<button

class="btn btn-success btn-lg"

onclick="downloadResult()">

<i class="bi bi-download"></i>

Download Result

</button>

</div>

<script>

// ===============================
// LOAD STUDENT INFORMATION
// ===============================

window.onload = function () {

    fetch("/student")
    .then(response => response.json())
    .then(data => {
        console.log(data);

        if (!data.success) {

            window.location.href = "/";

            return;

        }

        document.getElementById("studentName").innerHTML = data.student.name;

        document.getElementById("admission").innerHTML = data.student.admission;

        document.getElementById("className").innerHTML = data.student.class_name;

    });

};


// ===============================
// VIEW RESULT
// ===============================

function viewResult() {

    let year = document.getElementById("year").value.trim();

let term = document.getElementById("term").value;

if(year === ""){

    alert("Please enter Academic Session.");

    document.getElementById("year").focus();

    return;

}

if(term === ""){

    alert("Please select Term.");

    document.getElementById("term").focus();

    return;

}

    fetch("/results",{

        method:"POST",

        headers:{

            "Content-Type":"application/json"

        },

        body:JSON.stringify({

            year:year,

            term:term

        })

    })

    .then(response=>response.json())

    .then(data=>{

        if(!data.success){

            alert("Unable to load result.");

            return;

        }

        let html="";

        html+=`
        <h3 class="text-center mb-4">

        ST. PAUL'S SCHOOLS

        </h3>

        <table class="table table-bordered table-striped">

        <thead class="table-primary">

        <tr>

        <th>Subject</th>

        <th>CA</th>

        <th>Exam</th>

        <th>Total</th>

        <th>Grade</th>

        </tr>

        </thead>

        <tbody>
        `;

        let totalMarks=0;

        data.results.forEach(r=>{

            totalMarks += Number(r.total);

            html+=`

            <tr>

            <td>${r.subject}</td>

            <td>${r.ca}</td>

            <td>${r.exam}</td>

            <td>${r.total}</td>

            <td>${r.grade}</td>

            </tr>

            `;

        });

        let average=0;

        if(data.results.length>0){

            average=(totalMarks/data.results.length).toFixed(2);

        }

        html+=`

        </tbody>

        </table>

        <div class="mt-4">

        <h5>

        Overall Total : ${totalMarks}

        </h5>

        <h5>

        Average : ${average}

        </h5>

        </div>

        `;

        document.getElementById("result").innerHTML=html;

    });

}

// ===============================
// DOWNLOAD RESULT AS PDF
// ===============================

function downloadResult() {

    let year = document.getElementById("year").value.trim();
    let term = document.getElementById("term").value;

    if (year === "") {
        alert("Please enter Academic Session.");
        return;
    }

    let url = "/download_result?year=" + encodeURIComponent(year);

    if (term !== "") {
        url += "&term=" + encodeURIComponent(term);
    }

    window.location.href = url;
}


// ===============================
// LOGOUT
// ===============================

function logout(){

    fetch("/logout")

    .then(()=>{

        localStorage.clear();

        window.location.href="/";

    });

}

</script>

</body>

</html>



