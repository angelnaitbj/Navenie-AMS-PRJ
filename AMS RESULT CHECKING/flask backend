from flask import send_file
from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph
from reportlab.lib import colors
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.lib.units import inch
import tempfile

@app.route("/download_result")
def download_result():

    if "student_id" not in session:
        return redirect(url_for("home"))

    year = request.args.get("year")
    term = request.args.get("term")

    conn = get_db()
    cursor = conn.cursor()

    # Student information
    cursor.execute("""
        SELECT name, admission, class_name
        FROM students
        WHERE id=?
    """, (session["student_id"],))

    student = cursor.fetchone()

    # Results
    if term:
        cursor.execute("""
            SELECT subject, ca, exam, total, grade
            FROM results
            WHERE student_id=? AND year=? AND term=?
            ORDER BY subject
        """, (session["student_id"], year, term))
    else:
        cursor.execute("""
            SELECT subject, ca, exam, total, grade, term
            FROM results
            WHERE student_id=? AND year=?
            ORDER BY term, subject
        """, (session["student_id"], year))

    results = cursor.fetchall()
    conn.close()

    pdf = tempfile.NamedTemporaryFile(delete=False, suffix=".pdf")

    doc = SimpleDocTemplate(pdf.name)

    styles = getSampleStyleSheet()

    story = []

    story.append(Paragraph("<b>ST. PAUL'S SCHOOLS</b>", styles["Title"]))
    story.append(Paragraph("New Kutunku, Gwagwalada, Abuja", styles["Normal"]))
    story.append(Paragraph("<br/>", styles["Normal"]))

    story.append(Paragraph(f"<b>Name:</b> {student['name']}", styles["Normal"]))
    story.append(Paragraph(f"<b>Admission:</b> {student['admission']}", styles["Normal"]))
    story.append(Paragraph(f"<b>Class:</b> {student['class_name']}", styles["Normal"]))
    story.append(Paragraph(f"<b>Session:</b> {year}", styles["Normal"]))

    if term:
        story.append(Paragraph(f"<b>Term:</b> {term}", styles["Normal"]))

    story.append(Paragraph("<br/>", styles["Normal"]))

    table_data = [["Subject", "CA", "Exam", "Total", "Grade"]]

    total = 0

    for r in results:

        table_data.append([
            r["subject"],
            r["ca"],
            r["exam"],
            r["total"],
            r["grade"]
        ])

        total += r["total"]

    table = Table(table_data)

    table.setStyle(TableStyle([
        ("GRID",(0,0),(-1,-1),1,colors.black),
        ("BACKGROUND",(0,0),(-1,0),colors.darkblue),
        ("TEXTCOLOR",(0,0),(-1,0),colors.white),
        ("ALIGN",(0,0),(-1,-1),"CENTER"),
        ("FONTNAME",(0,0),(-1,0),"Helvetica-Bold"),
        ("BOTTOMPADDING",(0,0),(-1,0),8)
    ]))

    story.append(table)

    story.append(Paragraph("<br/>", styles["Normal"]))
    story.append(Paragraph(f"<b>Total:</b> {total}", styles["Heading2"]))

    if len(results):
        story.append(Paragraph(
            f"<b>Average:</b> {round(total/len(results),2)}",
            styles["Heading2"]
        ))

    doc.build(story)

    return send_file(
        pdf.name,
        as_attachment=True,
        download_name=f"{student['name']}_{year}_Result.pdf",
        mimetype="application/pdf"
    )
