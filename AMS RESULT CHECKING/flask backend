@app.route("/login", methods=["POST"])
def login():

    try:

        data = request.get_json()

        if not data:
            return jsonify({
                "success": False,
                "message": "No login data received."
            })

        name = data.get("username", "").strip()
        admission = data.get("password", "").strip()

        print("\n========== LOGIN ==========")
        print("Name:", name)
        print("Admission:", admission)

        conn = get_db()
        cursor = conn.cursor()

        cursor.execute("""
            SELECT
                id,
                name,
                admission,
                class_name
            FROM students
            WHERE
                UPPER(TRIM(name)) = UPPER(TRIM(?))
            AND
                TRIM(admission) = TRIM(?)
        """, (name, admission))

        student = cursor.fetchone()

        conn.close()

        if student:

            session["student_id"] = student["id"]

            print("LOGIN SUCCESS")

            return jsonify({
                "success": True,
                "student": {
                    "id": student["id"],
                    "name": student["name"],
                    "admission": student["admission"],
                    "class_name": student["class_name"]
                }
            })

        print("LOGIN FAILED")

        return jsonify({
            "success": False,
            "message": "Invalid Student Name or Admission Number."
        })

    except Exception as e:

        print("LOGIN ERROR:", e)

        return jsonify({
            "success": False,
            "message": str(e)
        })
