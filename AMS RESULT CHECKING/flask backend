@app.route("/results", methods=["POST"])
def results():

    if "student_id" not in session:

        return jsonify({

            "success": False,

            "message": "Please login first."

        })

    try:

        data = request.get_json()

        year = data.get("year", "").strip()

        term = data.get("term", "").strip()

        conn = get_db()

        cursor = conn.cursor()

        # --------------------------------------------------
        # If no term is selected, return ALL terms for year
        # --------------------------------------------------

        if term == "":

            cursor.execute("""

                SELECT
                    subject,
                    ca,
                    exam,
                    total,
                    grade,
                    term,
                    year

                FROM results

                WHERE
                    student_id = ?
                    AND year = ?

                ORDER BY term, subject

            """, (session["student_id"], year))

        else:

            cursor.execute("""

                SELECT
                    subject,
                    ca,
                    exam,
                    total,
                    grade,
                    term,
                    year

                FROM results

                WHERE
                    student_id = ?
                    AND year = ?
                    AND term = ?

                ORDER BY subject

            """, (session["student_id"], year, term))

        rows = cursor.fetchall()

        conn.close()

        return jsonify({

            "success": True,

            "results": [dict(r) for r in rows]

        })

    except Exception as e:

        print("RESULT ERROR:", e)

        return jsonify({

            "success": False,

            "message": str(e)

        })
